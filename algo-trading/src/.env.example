# Copy this file to .env and fill in your keys. .env is gitignored.
#
# Tiingo: https://www.tiingo.com  (free tier, then $10/month power tier)
TIINGO_API_KEY=

# Set to 5000 if you upgrade to the Tiingo power tier.
TIINGO_REQUESTS_PER_HOUR=50

# Alpaca paper trading: https://alpaca.markets  (free, no funding required)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
